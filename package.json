{
  "name": "rift-atlas",
  "version": "2.0.0",
  "description": "Aplicacion desktop de League of Legends basada en Data Dragon.",
  "main": "main.js",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "check": "node --check main.js && node --check preload.js && node --check src/renderer.js && node --check \"Pengu Loader/plugins/RiftAtlas-00-Core/index.js\" && node --check \"Pengu Loader/plugins/RiftAtlas-ChromaWheel/index.js\" && node --check \"Pengu Loader/plugins/RiftAtlas-FormsWheel/index.js\" && node --check \"Pengu Loader/plugins/RiftAtlas-HistoricMode/index.js\" && node --check \"Pengu Loader/plugins/RiftAtlas-Jade/index.js\" && node --check \"Pengu Loader/plugins/RiftAtlas-PartyMode/index.js\"",
    "dist": "tauri build",
    "release": "tauri build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "setup": "tauri build",
    "setup:debug": "tauri build --debug"
  },
  "keywords": [
    "tauri",
    "league-of-legends",
    "riot",
    "data-dragon"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.riftatlas.desktop",
    "productName": "Rift Atlas",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BEF172",
        "repo": "Rift"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "tutorial.js",
      "assets/**/*",
      "Pengu Loader/**/*",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/7z-wasm/**/*",
      "assets/cslol-dll.dll",
      "Pengu Loader/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "electron": "39.8.5",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "driver.js": "^1.4.0",
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "peerjs": "^1.5.5",
    "ws": "^8.21.0",
    "yauzl": "^3.3.2"
  }
}
